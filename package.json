    "@colyseus/clock": "1.0.1",
    "@colyseus/redis-driver": "0.16.1",
    "@colyseus/redis-presence": "0.16.4",
    "@colyseus/uwebsockets-transport": "0.16.10",
    "@colyseus/httpie": "2.0.1",
    "@colyseus/msgpackr": "1.11.3"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
